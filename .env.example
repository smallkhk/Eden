APP_PASSWORD=
# Hard cap per session (seconds)
MAX_SESSION_SECONDS=300
# lucy-latest | lucy-2.6 | lucy-2.5 | lucy-2.1
LUCY_MODEL=lucy-latest
FIRST_FRAME_MODEL=fal-ai/flux-2/klein/9b/edit
