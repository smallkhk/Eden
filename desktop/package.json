{
  "name": "livechar-desktop",
  "productName": "LiveChar",
  "version": "1.3.0",
  "description": "LiveChar desktop app with virtual camera output",
  "author": "LiveChar",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "koffi": "^3.3.7",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.livechar.desktop",
    "productName": "LiveChar",
    "files": [
      "main.js",
      "preload.js",
      "vcam.js",
      "wincam.js",
      "setup.html",
      "config.json",
      "icon.png"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "softcam",
        "to": "softcam"
      },
      {
        "from": "wincam-bin",
        "to": "wincam"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "artifactName": "LiveChar-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "smallkhk",
        "repo": "Eden",
        "releaseType": "release"
      }
    ]
  }
}
